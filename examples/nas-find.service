[Unit]
Description=NAS Find filename search
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/nas-find/current
ExecStart=/usr/bin/python3 -m nasfind --config %h/.config/nas-find/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
