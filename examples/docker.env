# 复制到 .local/docker.env 后填写真实环境；这些值只用于说明。
NAS_FIND_DATA_DIR=/srv/storage/files
NAS_FIND_CONFIG_DIR=/srv/nas-find
NAS_FIND_BIND_IP=192.0.2.10
NAS_FIND_PORT=8765
# 用 id -u / id -g 查询；运行用户必须能读取数据目录。
PUID=1000
PGID=1000
# 单引号保留反斜杠和 $ 等字符；一个实例对应一个 SMB 共享根目录。
NAS_FIND_UNC_PREFIX='\\nas.example.internal\files'
NAS_FIND_ALLOWED_NETWORKS=192.0.2.0/24
# 使用远程镜像时填写固定版本：ghcr.io/chess99/nas-find:<版本>
NAS_FIND_IMAGE=nas-find:local
